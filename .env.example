# ---------- Tienda ----------
STORE_NAME=Her Essence
TIMEZONE=America/Santiago
# Lo que el agente puede decirle a los clientes. Todo lo que NO esté aquí, lo deriva a una persona.
STORE_INFO="Despachos a todo Chile. Santiago: 2 a 4 días hábiles. Regiones: 3 a 6 días hábiles. Pago contra entrega en efectivo o transferencia. Horario de atención humana: lunes a viernes de 9:00 a 18:00. Cambios dentro de 10 días si el producto está sellado."

# ---------- Panel ----------
DASHBOARD_PASSWORD=pon-una-clave-larga
SESSION_SECRET=otra-cadena-larga-y-aleatoria

# ---------- WhatsApp (Meta) ----------
WHATSAPP_TOKEN=EAAG...            # token permanente de un usuario del sistema
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=inventa-una-palabra-secreta
META_APP_SECRET=abc123...          # Configuración de la app > Básica > Clave secreta
GRAPH_API_VERSION=v23.0

# ---------- Shopify ----------
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ACCESS_TOKEN=shpat_...   # solo si ya tienes una app antigua con token fijo
SHOPIFY_API_VERSION=2026-04
ORDER_LOOKBACK_DAYS=10             # cuántos días atrás buscar pedidos por teléfono
ORDER_RETRY_SECONDS=8,20           # si el pedido aún no aparece, reintenta tras 8 y 20 segundos
AUTO_CANCEL_IN_SHOPIFY=false       # true = cuando el cliente cancela, se cancela también en Shopify
TAG_CONFIRMED=WA-CONFIRMADO
TAG_CANCELLED=WA-CANCELADO
TAG_REVIEW=WA-REVISAR

# ---------- Mensaje de Releasit ----------
CONFIRM_ON_FIRST_MESSAGE=true      # si el mensaje dice "Confirmo mi pedido", se confirma directo (si dirección y total coinciden)
CONFIRM_PATTERN=confirmo mi pedido # frase que marca el mensaje como confirmación

# ---------- Pedidos sin mensaje ----------
ORDER_SYNC_MINUTES=2               # cada cuánto se leen pedidos nuevos de Shopify
ORDER_SYNC_DAYS=3                  # cuántos días hacia atrás se revisan
SILENT_AFTER_MINUTES=15            # desde cuándo un pedido aparece como "sin mensaje"
# Recordatorio automático (opcional). Vacío = no se envía nada, solo se listan en el panel.
REMINDER_TEMPLATE=                 # nombre exacto de la plantilla aprobada en Meta, ej: confirmar_pedido
REMINDER_TEMPLATE_LANG=es
REMINDER_TEMPLATE_PARAMS=nombre,pedido,total   # qué va en {{1}}, {{2}}, {{3}} (también: productos, direccion, tienda)
REMINDER_AFTER_MINUTES=30          # minutos después de la compra
REMINDER_QUIET_HOURS=22-9          # no enviar de 22:00 a 9:00 (se envía al terminar ese horario)
DEFAULT_COUNTRY_CODE=56

# ---------- Historial de la clienta (Dropi) ----------
# La revisión programada escribe en cada pedido de Shopify la etiqueta HIST-OK / HIST-BAJO / HIST-SIN-REGISTRO
# y una nota "Historial Dropi: 85% positivo (...)". Positivo = entregados ÷ (entregados + devueltos).
HISTORY_MIN_RATE=70
# Datos que el agente envía cuando pide pago por adelantado (usa \n para saltos de línea en Railway)
PREPAY_INFO="Banco: ...\nCuenta: ...\nRUT: ...\nNombre: ...\nCorreo: ..."
TAG_PREPAY=PAGO-ADELANTADO

# ---------- Validación de dirección (Google Maps) ----------
GOOGLE_MAPS_API_KEY=               # clave con la Geocoding API habilitada; vacío = no se valida
ADDRESS_COUNTRY=CL
ADDRESS_BLOCK_ON_DOUBT=true        # true = si la dirección no se encuentra o es dudosa, no confirma y pide la ubicación

# ---------- IA (OpenAI o Anthropic: basta una) ----------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_PROVIDER=openai               # opcional: openai | anthropic (por defecto, el que tenga clave)

# ---------- Servidor ----------
DATA_DIR=/data                     # en Railway, monta un volumen en /data
# DEMO=true                        # prueba sin Meta ni Shopify (pedidos de ejemplo)
